<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="true"/>

        <service id="Zanders\ProductCompare\Storefront\Page\Compare\ComparePageLoader">
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader"/>
            <argument type="service" id="sales_channel.product.repository"/>
        </service>

        <service id="Zanders\ProductCompare\Storefront\Controller\CompareController" public="true">
            <argument type="service" id="Zanders\ProductCompare\Storefront\Page\Compare\ComparePageLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>

