                        </svg>
                    </span>
                    <span class="top-bar-text">800.851.4373</span>
                </a>

                <div class="d-flex align-items-center text-white">
                    <span class="top-bar-circle-icon rounded-circle border border-2 border-white d-inline-flex align-items-center justify-content-center flex-shrink-0 me-2 me-lg-4">
                        <svg width="15" height="15" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M8.75016 1.45825C4.73245 1.45825 1.4585 4.73221 1.4585 8.74992C1.4585 12.7676 4.73245 16.0416 8.75016 16.0416C12.7679 16.0416 16.0418 12.7676 16.0418 8.74992C16.0418 4.73221 12.7679 1.45825 8.75016 1.45825ZM11.922 11.353C11.82 11.528 11.6377 11.6228 11.4481 11.6228C11.3533 11.6228 11.2585 11.601 11.171 11.5426L8.91058 10.1937C8.34912 9.85825 7.9335 9.12179 7.9335 8.47284V5.48325C7.9335 5.18429 8.18141 4.93638 8.48037 4.93638C8.77933 4.93638 9.02725 5.18429 9.02725 5.48325V8.47284C9.02725 8.73534 9.246 9.12179 9.47204 9.25304L11.7325 10.602C11.995 10.7551 12.0825 11.0905 11.922 11.353Z" fill="currentColor"/>
                        </svg>
                    </span>
                    <div class="top-bar-hours lh-sm">
                        <span class="d-none d-lg-block top-bar-hours-days">Mon - Fri</span>
                        <span class="d-block top-bar-hours-time">8:00AM To 4:30PM CST</span>
                    </div>
                </div>
            </div>

            {# Right Side: Welcome text / Account Dropdown & Login / Logout #}
            <div class="d-none d-lg-flex align-items-center gap-4">
                {% if context.customer %}
                    <div class="dropdown top-bar-account-dropdown">
                        <button class="top-bar-account-btn btn btn-link p-0 border-0 shadow-none d-flex align-items-center text-white text-decoration-none"
                                type="button"
                                id="topBarAccountWidget"
                                data-account-menu="true"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="{{ 'account.myAccount'|trans|striptags }}"
                                title="{{ 'account.myAccount'|trans|striptags }}">
                            <span class="top-bar-circle-icon rounded-circle border border-2 border-white d-inline-flex align-items-center justify-content-center flex-shrink-0 me-2">
                                <svg width="15" height="15" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M8.75033 8.74992C10.7639 8.74992 12.3962 7.11762 12.3962 5.10409C12.3962 3.09055 10.7639 1.45825 8.75033 1.45825C6.73679 1.45825 5.10449 3.09055 5.10449 5.10409C5.10449 7.11762 6.73679 8.74992 8.75033 8.74992Z" fill="currentColor"/>
                                    <path d="M8.7502 10.573C5.09707 10.573 2.12207 13.023 2.12207 16.0417C2.12207 16.2459 2.28249 16.4063 2.48665 16.4063H15.0137C15.2179 16.4063 15.3783 16.2459 15.3783 16.0417C15.3783 13.023 12.4033 10.573 8.7502 10.573Z" fill="currentColor"/>
                                </svg>
                            </span>
                            <span class="top-bar-text">My Account</span>
                        </button>

                        <div class="dropdown-menu dropdown-menu-end account-menu-dropdown js-account-menu-dropdown"
                            aria-labelledby="topBarAccountWidget">
                            {% sw_include '@Storefront/storefront/layout/header/account-menu.html.twig' %}
                        </div>
                    </div>
                    <a href="{{ path('frontend.account.logout.page') }}" class="d-flex align-items-center text-white text-decoration-none">
                        <span class="top-bar-circle-icon rounded-circle border border-2 border-white d-inline-flex align-items-center justify-content-center flex-shrink-0 me-2">
                            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7.84583 1.45825C7.49583 1.45825 7.21875 1.73534 7.21875 2.08534V8.25409H9.89479L8.75 7.10929C8.53854 6.89784 8.53854 6.54784 8.75 6.33638C8.96146 6.12492 9.31146 6.12492 9.52292 6.33638L11.5938 8.4145C11.8052 8.62596 11.8052 8.97596 11.5938 9.18742L9.52292 11.2655C9.41354 11.3749 9.275 11.426 9.13646 11.426C8.99792 11.426 8.85938 11.3749 8.75 11.2655C8.53854 11.0541 8.53854 10.7041 8.75 10.4926L9.8875 9.35513H7.21875V15.4291C7.21875 15.7718 7.49583 16.0562 7.84583 16.0562C12.1406 16.0562 15.1375 13.0593 15.1375 8.7645C15.1375 4.46971 12.1333 1.45825 7.84583 1.45825Z" fill="currentColor"/>
                                <path d="M2.90918 8.25415C2.61022 8.25415 2.3623 8.50207 2.3623 8.80103C2.3623 9.09998 2.61022 9.3479 2.90918 9.3479H7.21126V8.25415H2.90918Z" fill="currentColor"/>
                            </svg>
                        </span>
                        <span class="top-bar-text">LogOut</span>
                    </a>
                {% else %}
                    {% block layout_header_top_bar_welcome %}
                    <span class="top-bar-welcome text-white">{{ 'zanders.topBar.welcome'|trans|sw_sanitize }}</span>
                    {% endblock %}
                    <a href="{{ path('frontend.account.login.page') }}" class="d-flex align-items-center text-white text-decoration-none">
                        <span class="top-bar-circle-icon rounded-circle border border-2 border-white d-inline-flex align-items-center justify-content-center flex-shrink-0 me-2">
                            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7.84583 1.45825C7.49583 1.45825 7.21875 1.73534 7.21875 2.08534V8.25409H9.89479L8.75 7.10929C8.53854 6.89784 8.53854 6.54784 8.75 6.33638C8.96146 6.12492 9.31146 6.12492 9.52292 6.33638L11.5938 8.4145C11.8052 8.62596 11.8052 8.97596 11.5938 9.18742L9.52292 11.2655C9.41354 11.3749 9.275 11.426 9.13646 11.426C8.99792 11.426 8.85938 11.3749 8.75 11.2655C8.53854 11.0541 8.53854 10.7041 8.75 10.4926L9.8875 9.35513H7.21875V15.4291C7.21875 15.7718 7.49583 16.0562 7.84583 16.0562C12.1406 16.0562 15.1375 13.0593 15.1375 8.7645C15.1375 4.46971 12.1333 1.45825 7.84583 1.45825Z" fill="currentColor"/>
                                <path d="M2.90918 8.25415C2.61022 8.25415 2.3623 8.50207 2.3623 8.80103C2.3623 9.09998 2.61022 9.3479 2.90918 9.3479H7.21126V8.25415H2.90918Z" fill="currentColor"/>
                            </svg>
                        </span>
                        <span class="top-bar-text">LogIn</span>
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
{% endblock %}
