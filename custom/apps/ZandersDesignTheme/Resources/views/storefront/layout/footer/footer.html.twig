{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{% block layout_footer_inner_container %}
    <div class="footer-top py-5">
        <div class="container">
            <div class="row footer-main-row align-items-start gy-4 gy-lg-0">                
                {% if footer.navigation and footer.navigation.tree %}
                    {% for root in footer.navigation.tree %}
                        <div class="col-12 col-sm-6 col-md-6 col-lg-2 footer-col footer-col-nav">
                            <h5 class="footer-col-headline text-uppercase fw-medium text-dark mb-4">
                                {% if root.category.type == 'folder' %}
                                    {{ root.category.translated.name }}
                                {% else %}
                                    <a href="{{ root.category.seoUrl }}"
                                       class="text-decoration-none text-dark"
                                       {% if root.category.shouldOpenInNewTab %}target="_blank"{% endif %}
                                       title="{{ root.category.translated.name }}">
                                        {{ root.category.translated.name }}
                                    </a>
                                {% endif %}
                            </h5>

                            {% if root.children|length > 0 %}
                                <ul class="footer-nav-list list-unstyled m-0 p-0">
                                    {% for treeItem in root.children %}
                                        {% set category = treeItem.category %}
                                        {% set name = category.translated.name %}
                                        <li class="footer-nav-item mb-3">
                                            {% if category.type == 'folder' %}
                                                <span class="text-secondary">{{ name }}</span>
                                            {% else %}
                                                <a class="footer-nav-link text-decoration-none text-secondary"
                                                   href="{{ category.seoUrl }}"
                                                   {% if category.shouldOpenInNewTab %}target="_blank"{% endif %}
                                                   title="{{ name }}">
                                                    {{ name }}
                                                </a>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}

                
                <div class="col-12 col-sm-6 col-md-6 col-lg-4 footer-col footer-col-contact">
                    <div class="footer-contact-items d-flex flex-column gap-3 gap-md-4">
                        <div class="footer-contact-item footer-contact-phone">
                            <a href="tel:{{ 'zanders.topBar.phone'|trans|striptags }}" class="footer-contact-link d-flex align-items-center text-decoration-none text-reset" title="{{ 'zanders.topBar.phoneTitle'|trans|striptags }}">
                                <span class="footer-icon-circle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M8.05745 10.901L6.7085 12.2499C6.42412 12.5343 5.97204 12.5343 5.68037 12.2572C5.60016 12.177 5.51995 12.1041 5.43975 12.0239C4.6887 11.2655 4.01058 10.4708 3.40537 9.6395C2.80745 8.80825 2.3262 7.977 1.9762 7.15304C1.6335 6.32179 1.4585 5.527 1.4585 4.76867C1.4585 4.27284 1.546 3.79888 1.721 3.36138C1.896 2.91659 2.17308 2.50825 2.55954 2.14367C3.0262 1.68429 3.53662 1.45825 4.0762 1.45825C4.28037 1.45825 4.48454 1.502 4.66683 1.5895C4.85641 1.677 5.02412 1.80825 5.15537 1.99784L6.84704 4.38221C6.97829 4.5645 7.07308 4.73221 7.1387 4.89263C7.20433 5.04575 7.24079 5.19888 7.24079 5.33742C7.24079 5.51242 7.18975 5.68742 7.08766 5.85513C6.99287 6.02284 6.85433 6.19784 6.67933 6.37284L6.12516 6.94888C6.04495 7.02909 6.0085 7.12388 6.0085 7.24054C6.0085 7.29888 6.01579 7.34992 6.03037 7.40825C6.05225 7.46659 6.07412 7.51033 6.08871 7.55409C6.21995 7.79471 6.446 8.10825 6.76683 8.48742C7.09495 8.86659 7.44495 9.25304 7.82412 9.6395C7.89704 9.71242 7.97725 9.78534 8.05016 9.85825C8.34183 10.1426 8.34912 10.6093 8.05745 10.901Z" fill="#991020"/>
                                        <path d="M16.0198 13.3657C16.0198 13.5698 15.9833 13.7813 15.9104 13.9855C15.8885 14.0438 15.8667 14.1021 15.8375 14.1605C15.7135 14.423 15.5531 14.6709 15.3417 14.9042C14.9844 15.298 14.5906 15.5823 14.1458 15.7646C14.1385 15.7646 14.1313 15.7719 14.124 15.7719C13.6938 15.9469 13.2271 16.0417 12.724 16.0417C11.9802 16.0417 11.1854 15.8667 10.3469 15.5094C9.50833 15.1521 8.66979 14.6709 7.83854 14.0657C7.55417 13.8542 7.26979 13.6428 7 13.4167L9.38437 11.0323C9.58854 11.1855 9.77083 11.3021 9.92396 11.3823C9.96042 11.3969 10.0042 11.4188 10.0552 11.4407C10.1135 11.4625 10.1719 11.4698 10.2375 11.4698C10.3615 11.4698 10.4562 11.4261 10.5365 11.3459L11.0906 10.799C11.2729 10.6167 11.4479 10.4782 11.6156 10.3907C11.7833 10.2886 11.951 10.2375 12.1333 10.2375C12.2719 10.2375 12.4177 10.2667 12.5781 10.3323C12.7385 10.398 12.9063 10.4928 13.0885 10.6167L15.5021 12.3303C15.6917 12.4615 15.8229 12.6146 15.9031 12.7969C15.976 12.9792 16.0198 13.1615 16.0198 13.3657Z" fill="#991020"/>
                                    </svg>
                                </span>
                                <span class="footer-contact-text footer-contact-phone-text text-dark">
                                    {{ 'zanders.topBar.phone'|trans|sw_sanitize }}
                                </span>
                            </a>
                        </div>

                        <div class="footer-contact-item footer-contact-hours d-flex align-items-center">
                            <span class="footer-icon-circle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3">
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M8.75016 1.45825C4.73245 1.45825 1.4585 4.73221 1.4585 8.74992C1.4585 12.7676 4.73245 16.0416 8.75016 16.0416C12.7679 16.0416 16.0418 12.7676 16.0418 8.74992C16.0418 4.73221 12.7679 1.45825 8.75016 1.45825ZM11.922 11.353C11.82 11.528 11.6377 11.6228 11.4481 11.6228C11.3533 11.6228 11.2585 11.601 11.171 11.5426L8.91058 10.1937C8.34912 9.85825 7.9335 9.12179 7.9335 8.47284V5.48325C7.9335 5.18429 8.18141 4.93638 8.48037 4.93638C8.77933 4.93638 9.02725 5.18429 9.02725 5.48325V8.47284C9.02725 8.73534 9.246 9.12179 9.47204 9.25304L11.7325 10.602C11.995 10.7551 12.0825 11.0905 11.922 11.353Z" fill="#991020"/>
                                </svg>
                            </span>
                            <div class="footer-contact-text footer-contact-hours-text d-flex flex-column text-dark">
                                <span class="footer-hours-days">{{ 'zanders.topBar.hoursDays'|trans|sw_sanitize }}</span>
                                <span class="footer-hours-time">{{ 'zanders.topBar.hoursTime'|trans|sw_sanitize }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Zanders Logo #}
                <div class="col-12 col-sm-6 col-md-6 col-lg-4 footer-col footer-col-logo text-lg-end text-start">
                    {% if theme_config('sw-logo-desktop') %}
                        <a href="{{ path('frontend.home.page') }}" title="{{ 'header.logoLink'|trans|striptags }}" class="footer-logo-link d-inline-block">
                            <img src="{{ theme_config('sw-logo-desktop')|sw_encode_url }}"
                                 alt="{{ 'header.logoLink'|trans|striptags }}"
                                 class="img-fluid footer-logo-img">
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Bottom Bar (Red Strip) #}
    <div class="footer-bottom-bar bg-primary text-white py-3">
        <div class="container">
            <div class="footer-bottom-inner d-flex flex-column flex-lg-row justify-content-between align-items-center gap-3">
                <div class="footer-bottom-left d-flex align-items-center">
                    <span class="footer-stay-connected text-white fw-medium me-3">{{ 'zanders.footer.stayConnected'|trans }}</span>
                    <div class="footer-social-icons d-flex align-items-center gap-3">
                        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="footer-social-link text-white d-inline-flex align-items-center justify-content-center text-decoration-none" aria-label="Facebook">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer-social-link text-white d-inline-flex align-items-center justify-content-center text-decoration-none" aria-label="Instagram">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                        </a>
                        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="footer-social-link text-white d-inline-flex align-items-center justify-content-center text-decoration-none" aria-label="Twitter">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.936 9.936 0 0024 4.59z"/></svg>
                        </a>
                    </div>
                </div>

                <div class="footer-bottom-right text-lg-end text-center">
                    <div class="footer-copyright-line mb-1">
                        {{ 'zanders.footer.copyrightNotice'|trans({'%year%': 'now'|date('Y')}) }}
                    </div>
                    <div class="footer-distributor-line">
                        {{ 'zanders.footer.distributorNotice'|trans }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}


