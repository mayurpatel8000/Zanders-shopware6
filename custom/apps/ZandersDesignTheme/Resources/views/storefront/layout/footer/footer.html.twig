{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{% block layout_footer_inner_container %}
    {% set lblPhone = 'zanders.topBar.phone'|trans %}
    {% if 'zanders.' in lblPhone|lower or lblPhone == '' %}{% set lblPhone = '800-851-4373' %}{% endif %}

    {% set lblPhoneTitle = 'zanders.topBar.phoneTitle'|trans %}
    {% if 'zanders.' in lblPhoneTitle|lower or lblPhoneTitle == '' %}{% set lblPhoneTitle = 'Call us at 800-851-4373' %}{% endif %}

    {% set lblHoursDays = 'zanders.topBar.hoursDays'|trans %}
    {% if 'zanders.' in lblHoursDays|lower or lblHoursDays == '' %}{% set lblHoursDays = 'Mon - Fri' %}{% endif %}

    {% set lblHoursTime = 'zanders.topBar.hoursTime'|trans %}
    {% if 'zanders.' in lblHoursTime|lower or lblHoursTime == '' %}{% set lblHoursTime = '8:00 AM - 4:30 PM CST' %}{% endif %}

    {% set lblStayConnected = 'zanders.footer.stayConnected'|trans %}
    {% if 'zanders.' in lblStayConnected|lower or lblStayConnected == '' %}{% set lblStayConnected = 'Stay Connected' %}{% endif %}

    {% set currentYear = "now"|date("Y") %}
    {% set lblCopyrightNotice = 'zanders.footer.copyrightNotice'|trans({'%year%': currentYear}) %}
    {% if 'zanders.' in lblCopyrightNotice|lower or lblCopyrightNotice == '' %}{% set lblCopyrightNotice = '© 1996-' ~ currentYear ~ ' Zanders Sporting Goods' %}{% endif %}

    {% set lblDistributorNotice = 'zanders.footer.distributorNotice'|trans %}
    {% if 'zanders.' in lblDistributorNotice|lower or lblDistributorNotice == '' %}{% set lblDistributorNotice = 'Zanders Sporting Goods is a wholesale firearms distributor selling only to federally licensed dealers' %}{% endif %}

    <div class="footer-top">
        <div class="container">
            <div class="row footer-main-row align-items-start">
                {# Navigation columns: Company & Resources from footer.navigation.tree #}
                {% if footer.navigation and footer.navigation.tree %}
                    {% for root in footer.navigation.tree %}
                        <div class="col-6 col-md-6 col-lg-3 col-xl-2 footer-col footer-col-nav">
                            <h5 class="footer-col-headline">
                                {% if root.category.type == 'folder' %}
                                    {{ root.category.translated.name }}
                                {% else %}
                                    <a href="{{ root.category.seoUrl }}"
                                       {% if root.category.shouldOpenInNewTab %}target="_blank"{% endif %}
                                       title="{{ root.category.translated.name }}">
                                        {{ root.category.translated.name }}
                                    </a>
                                {% endif %}
                            </h5>

                            {% if root.children|length > 0 %}
                                <ul class="footer-nav-list list-unstyled">
                                    {% for treeItem in root.children %}
                                        {% set category = treeItem.category %}
                                        {% set name = category.translated.name %}
                                        <li class="footer-nav-item">
                                            {% if category.type == 'folder' %}
                                                <span>{{ name }}</span>
                                            {% else %}
                                                <a class="footer-nav-link"
                                                   href="{{ category.seoUrl }}"
                                                   {% if category.shouldOpenInNewTab %}target="_blank"{% endif %}
                                                   title="{{ name }}">
                                                    {{ name }}
                                                </a>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}

                {# Contact Info: Phone & Working Hours with red circular icons #}
                <div class="col-6 col-md-6 col-lg-3 col-xl-3 footer-col footer-col-contact">
                    <div class="footer-contact-items">
                        <div class="footer-contact-item footer-contact-phone">
                            <a href="tel:{{ lblPhone|striptags }}" class="footer-contact-link" title="{{ lblPhoneTitle|striptags }}">
                                <span class="footer-icon-circle">
                                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
