{% sw_extends '@Storefront/storefront/element/cms-element-sidebar-filter.html.twig' %}

{% block element_product_listing_filter_button %}
    {% set shopSnippet = 'zanders.listing.shoppingOptions'|trans %}
    {% set shoppingTitle = (shopSnippet != 'zanders.listing.shoppingOptions') ? shopSnippet : 'SHOPPING OPTIONS' %}

    <button
        class="filter-panel-wrapper-toggle"
        type="button"
        data-off-canvas-filter="true"
        aria-haspopup="dialog"
    >
        <span class="filter-panel-wrapper-toggle-title">
            {{ shoppingTitle }}
        </span>
        <span class="filter-panel-wrapper-toggle-icon" aria-hidden="true">
            <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13.5101 15.1999L15.4801 13.2299L18.6901 10.0199C19.3601 9.33993 18.8801 8.17993 17.9201 8.17993L11.6901 8.17993L6.08007 8.17993C5.12007 8.17993 4.64007 9.33993 5.32007 10.0199L10.5001 15.1999C11.3201 16.0299 12.6801 16.0299 13.5101 15.1999Z" fill="#292D32"/>
            </svg>
        </span>
    </button>
{% endblock %}

{% block element_sidebar_filter_panel %}
    <div
        id="filter-panel-wrapper"
        class="filter-panel-wrapper"
        data-off-canvas-filter-content="true"
    >
        {% sw_include '@Storefront/storefront/component/listing/filter-panel.html.twig' with {
            listing: listing,
            sidebar: true,
            ariaLiveUpdates: true
        } %}
    </div>
{% endblock %}
