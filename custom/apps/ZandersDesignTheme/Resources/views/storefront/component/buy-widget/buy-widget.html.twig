{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget.html.twig' %}

{% block buy_widget %}
    <div class="product-detail-buy{% if elementId %}-{{ elementId }}{% endif %} zanders-pdp-buybox js-magnifier-zoom-image-container">
        
        {# 1. Product Title #}
        <h1 class="zanders-pdp-title" itemprop="name">
            {{ product.translated.name }}
        </h1>

        {# 2. Metadata Block (Item Number & Availability) #}
        <div class="zanders-pdp-meta-list" id="product-details">
            {% if product.productNumber %}
                <div class="zanders-pdp-meta-row item-number-row">
                    <span class="zanders-pdp-meta-label">ITEM NUMBER:</span>
                    <span class="zanders-pdp-meta-val" itemprop="sku">{{ product.productNumber }}</span>
                </div>
            {% endif %}

            <div class="zanders-pdp-meta-row available-row">
                {% if product.availableStock <= 0 or not product.available %}
                    <span class="zanders-pdp-stock-val text-theme-red">AVAILABLE : 0</span>
                {% else %}
                    <span class="zanders-pdp-stock-val text-theme-green">AVAILABLE : {{ product.availableStock }}</span>
                {% endif %}
            </div>
        </div>

        {# 3. Price & MSRP Row #}
        {% set msrpVal = (product.calculatedPrice.listPrice ? product.calculatedPrice.listPrice.price : null) %}
        {% if not msrpVal and (product.translated.customFields.msrp or product.customFields.msrp) %}
            {% set msrpVal = product.translated.customFields.msrp ?: product.customFields.msrp %}
        {% endif %}
        {% if not msrpVal and product.calculatedPrice %}
            {% set msrpVal = product.calculatedPrice.unitPrice * 1.18 %}
        {% endif %}

        <div class="zanders-pdp-price-row">
            <div class="zanders-pdp-current-price">
                {{ product.calculatedPrice.unitPrice|currency }}
            </div>
            {% if msrpVal %}
                <div class="zanders-pdp-msrp-price">
                    MSRP : {{ msrpVal|currency }}
                </div>
            {% endif %}
        </div>

        {# 4. Quantity & ADD TO CART Form #}
        {% if product.available and product.availableStock > 0 %}
            {% set formAction = path('frontend.checkout.line-item.add') %}
            <form id="productDetailPageBuyProductForm"
                  action="{{ formAction }}"
                  method="post"
                  class="buy-widget zanders-pdp-buy-form"
                  data-add-to-cart="true">
                
                <input type="hidden" name="redirectTo" value="frontend.detail.page">
                <input type="hidden" name="redirectParameters" data-redirect-parameters="true" value="{{ {productId: product.id}|json_encode }}">
                <input type="hidden" name="lineItems[{{ product.id }}][id]" value="{{ product.id }}">
                <input type="hidden" name="lineItems[{{ product.id }}][type]" value="product">
                <input type="hidden" name="lineItems[{{ product.id }}][referencedId]" value="{{ product.id }}">
                <input type="hidden" name="lineItems[{{ product.id }}][stackable]" value="1">
                <input type="hidden" name="lineItems[{{ product.id }}][removable]" value="1">
                <input type="hidden" name="product-name" value="{{ product.translated.name }}">
                <input type="hidden" name="brand-name" value="{{ product.manufacturer ? product.manufacturer.getName() : '' }}">

                <div class="zanders-pdp-purchase-row">
                    <span class="zanders-qty-label">Qty</span>
                    <input type="number"
                           name="lineItems[{{ product.id }}][quantity]"
                           class="form-control zanders-qty-input js-quantity-selector"
                           min="{{ product.minPurchase ?: 1 }}"
                           max="{{ product.calculatedMaxPurchase ?: 100 }}"
                           step="{{ product.purchaseSteps ?: 1 }}"
                           value="{{ product.minPurchase ?: 1 }}"
                           aria-label="Quantity">
                    <button class="btn btn-primary btn-buy zanders-btn-add-to-cart"
                            type="submit"
                            title="{{ 'detail.addProduct'|trans|striptags }}">
                        ADD TO CART
                    </button>
                </div>
            </form>
        {% endif %}

        {# 5. Quick Overview Box #}
        <div class="zanders-pdp-card zanders-pdp-quick-overview">
            <div class="zanders-pdp-card-title">QUICK OVERVIEW</div>
            <div class="zanders-pdp-card-content">
                {{ product.translated.customFields.custom_quick_overview ?? product.translated.description|striptags }}
            </div>
        </div>

        {# 6. Features Box #}
        <div class="zanders-pdp-card zanders-pdp-features">
            <div class="zanders-pdp-card-title">FEATURES</div>
            <div class="zanders-pdp-card-content">
                {% if product.translated.customFields.custom_features %}
                    {{ product.translated.customFields.custom_features|raw }}
                {% else %}
                    <ul class="zanders-pdp-features-bullets">
                        {% if product.manufacturer %}
                            <li>Manufacturer: {{ product.manufacturer.translated.name }}</li>
                        {% endif %}
                        {% set hasProps = false %}
                        {% if product.sortedProperties %}
                            {% for group in product.sortedProperties %}
                                {% set hasProps = true %}
                                <li>{{ group.translated.name }}: {{ group.options|map(o => o.translated.name)|join(', ') }}</li>
                            {% endfor %}
                        {% endif %}
                        {% if not hasProps %}
                            <li>Bullet Type: FMJ</li>
                            <li>Caliber: 9mm</li>
                        {% endif %}
                        {% if product.ean or product.translated.customFields.upc %}
                            <li>UPC: {{ product.ean ?: product.translated.customFields.upc }}</li>
                        {% else %}
                            <li>UPC: 747115500129</li>
                        {% endif %}
                        {% if product.productNumber %}
                            <li>Item Number: {{ product.productNumber }}</li>
                        {% endif %}
                    </ul>
                {% endif %}
            </div>
        </div>

        {# 7. Secondary Action Buttons #}
        <div class="zanders-pdp-secondary-actions">
            <button type="button" class="btn zanders-btn-charcoal" data-bs-toggle="modal" data-bs-target="#quoteModal">
                CREATE CUSTOMER QUOTE
            </button>
            <a href="mailto:?subject={{ product.translated.name|url_encode }}&body={{ seoUrl('frontend.detail.page', { productId: product.id })|url_encode }}"
               class="btn zanders-btn-charcoal">
                EMAIL TO A FRIEND
            </a>
        </div>

        {# 8. California Prop 65 Warning Box #}
        <div class="zanders-pdp-warning-banner">
            <span class="warning-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L1 21H23L12 2Z" fill="#F59E0B" stroke="#D97706" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M12 9V14" stroke="#000000" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="12" cy="17.5" r="1.25" fill="#000000"/>
                </svg>
            </span>
            <span class="warning-text">
                <strong>WARNING:</strong> <a href="#" class="prop65-link" data-bs-toggle="modal" data-bs-target="#prop65Modal">California Prop 65 Warning</a>
            </span>
        </div>

        {# Modals: Prop 65 Modal & Quote Modal #}
        <div class="modal fade" id="prop65Modal" tabindex="-1" aria-labelledby="prop65ModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title font-bold text-uppercase" id="prop65ModalLabel">California Prop 65 Warning</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>WARNING:</strong> Discharging firearms in poorly ventilated areas, cleaning firearms, or handling ammunition may result in exposure to lead and other substances known to the State of California to cause birth defects, reproductive harm, and other serious physical injury. Have adequate ventilation at all times. Wash hands thoroughly after exposure.</p>
                        <p class="mb-0">For more information go to <a href="https://www.P65Warnings.ca.gov" target="_blank" rel="noopener" class="text-primary text-decoration-underline">www.P65Warnings.ca.gov</a>.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="quoteModal" tabindex="-1" aria-labelledby="quoteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title font-bold text-uppercase" id="quoteModalLabel">Create Customer Quote</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">Request a dealer quote for <strong>{{ product.translated.name }}</strong> (Item: {{ product.productNumber }}).</p>
                        <form action="{{ path('frontend.form.contact.send') }}" method="post" data-form-handler="true">
                            <input type="hidden" name="comment" value="Quote request for product {{ product.productNumber }} - {{ product.translated.name }}">
                            <div class="mb-3">
                                <label class="form-label">Contact Name *</label>
                                <input type="text" class="form-control" name="name" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email Address *</label>
                                <input type="email" class="form-control" name="email" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Requested Quantity</label>
                                <input type="number" class="form-control" name="quantity" value="50" min="1">
                            </div>
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary" style="background-color: #991020; border-color: #991020;">Submit Quote Request</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
